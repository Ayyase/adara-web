# Salin file ini menjadi `.env` dan isi sesuai kebutuhan.
# Semua variabel opsional — situs tetap berjalan tanpa .env.

# Ubah domain publik (untuk sitemap/canonical)
# PUBLIC_SITE_URL=https://adararelief.com

# Integrasi analytics (jika dipasang plugin @astrojs/partytown / @astrojs/atatus)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX

# API untuk sumber konten jarak jauh (WordPress REST API misalnya)
# PUBLIC_WP_API_URL=https://adararelief.com/wp-json/wp/v2
# PUBLIC_WP_API_KEY=<token read-only>