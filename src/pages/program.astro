---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import KartuProgram from '../components/KartuProgram.astro';
import { SITE, REK_ONGKOS } from '../data/site';
import {
  PROGRAM_PENYALURAN,
  PROGRAM_EDUKASI,
  SEMUA_PROGRAM,
  SDG_LIST,
} from '../data/program';

const idAnchor = (slug: string) => {
  const map: Record<string, string> = {
    'pemberdayaan-perempuan': 'perempuan',
    'dekap-yatim-palestina': 'dyp',
    'hidupkan-ahlul-quran': 'haq',
    'program-darurat': 'darurat',
    'air-bersih': 'air',
    'bagi-bagi-qurban': 'bbq',
    'satu-rumah-satu-aqsa': 'satu-rumah',
  };
  return map[slug] ?? slug;
};
---

<BaseLayout
  title="Program Adara"
  description="12 program Adara: 6 penyaluran bantuan dan 6 edukasi kepalestinian. Dari Pemberdayaan Perempuan, Dekap Yatim, hingga Satu Rumah Satu Aqsa."
  image="/img/program-hero.jpg"
>
  <!-- ============ HERO HALAMAN ============ -->
  <section class="relative overflow-hidden bg-slate-950 pt-32 pb-16 sm:pt-40 sm:pb-20">
    <div class="pointer-events-none absolute inset-0 grid-pattern opacity-70"></div>
    <div class="pointer-events-none absolute -top-20 -right-10 h-80 w-80 rounded-full bg-brand-600/25 blur-[100px]"></div>
    <div class="pointer-events-none absolute bottom-0 left-1/4 h-64 w-64 rounded-full bg-amber-500/10 blur-[100px]"></div>

    <div class="container-page relative">
      <div class="max-w-3xl">
        <nav class="animate-fade-up flex items-center gap-2 text-xs font-semibold text-slate-400">
          <a href="/" class="transition hover:text-brand-300">Beranda</a>
          <span aria-hidden="true">/</span>
          <span class="text-brand-300">Program</span>
        </nav>

        <h1 class="mt-6 animate-fade-up text-4xl leading-tight font-extrabold text-white sm:text-5xl" style="animation-delay: 80ms">
          {SEMUA_PROGRAM.length} program, <span class="text-gradient-light">satu keberpihakan</span>
        </h1>
        <p class="mt-5 animate-fade-up max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg" style="animation-delay: 160ms">
          Dari kebutuhan darurat paling mendesak hingga program jangka panjang yang menumbuhkan
          kemandirian — setiap program Adara dirancang transparan, terukur, dan menyentuh langsung
          anak-anak serta perempuan Palestina.
        </p>

        <!-- Quick nav -->
        <div class="mt-9 flex animate-fade-up flex-wrap gap-2" style="animation-delay: 240ms">
          {SEMUA_PROGRAM.map((p) => (
            <a href={`#${idAnchor(p.slug)}`} class="chip bg-white/10 text-brand-100 ring-1 ring-white/15 backdrop-blur transition hover:bg-white/20 hover:text-white">
              {p.nama}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TAB PENCARIAN ============ -->
  <div class="no-print border-b border-slate-200 bg-white py-4">
    <div class="container-page flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm font-semibold text-slate-600">
        <span class="text-brand-700 font-extrabold">{SEMUA_PROGRAM.length}</span> program terdaftar
      </p>
      <div class="flex items-center gap-2 text-sm font-bold">
        <a href="#penyaluran" class="chip bg-amber-100 text-amber-800 transition hover:bg-amber-200">Penyaluran</a>
        <a href="#edukasi" class="chip bg-indigo-100 text-indigo-800 transition hover:bg-indigo-200">Edukasi</a>
      </div>
    </div>
  </div>

  <!-- ============ PENYALURAN ============ -->
  <section id="penyaluran" class="scroll-mt-24 bg-sand-100 py-16 sm:py-20">
    <div class="container-page">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow">Penyaluran Bantuan</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">
          Penyaluran yang sampai ke tangan
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Enam program penyaluran Adara yang menjawab kebutuhan dasar paling mendesak warga Palestina.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {PROGRAM_PENYALURAN.map((p, i) => (
          <KartuProgram program={p} index={i} anchorId={idAnchor(p.slug)} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EDUKASI ============ -->
  <section id="edukasi" class="scroll-mt-24 py-16 sm:py-20">
    <div class="container-page">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow">Edukasi &amp; Riset</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">
          Menumbuhkan kesadaran sejak dini
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Enam program edukasi untuk menanamkan cinta dan pemahaman Baitul Maqdis — dari keluarga
          hingga forum global.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {PROGRAM_EDUKASI.map((p, i) => (
          <KartuProgram program={p} index={i} anchorId={idAnchor(p.slug)} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SDG GRID ============ -->
  <section class="bg-slate-950 py-16 sm:py-20">
    <div class="container-page">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow bg-white/10 text-brand-200 ring-white/20">Dampak Terukur</span>
        <h2 class="mt-4 text-3xl leading-tight text-white sm:text-4xl">
          Setiap program memetakan ke SDGs
        </h2>
        <p class="mt-4 text-slate-300">Kontribusi Adara pada tujuan pembangunan berkelanjutan PBB.</p>
      </div>

      <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {SDG_LIST.filter((s) => [1, 2, 3, 4, 5, 6, 8, 10, 11, 12, 13, 16, 17].includes(s.no))
          .map((s, i) => (
            <div class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur" data-reveal data-reveal-delay={i * 40}>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/10 font-display text-sm font-extrabold text-brand-300">
                {s.no}
              </span>
              <div class="min-w-0">
                <h3 class="text-sm font-bold text-white">{s.name}</h3>
                <p class="mt-0.5 text-xs leading-relaxed text-slate-400">{s.full}</p>
              </div>
            </div>
          ))}
      </div>
    </div>
  </section>

  <!-- ============ REKENING ============ -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-white p-8 sm:p-12" data-reveal>
        <div class="pointer-events-none absolute -top-10 -right-10 h-48 w-48 rounded-full bg-brand-100/60 blur-3xl"></div>

        <div class="grid items-center gap-10 lg:grid-cols-2">
          <div>
            <span class="eyebrow">Cara Berdonasi</span>
            <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">
              Donasi mudah & transparan
            </h2>
            <p class="mt-4 text-base leading-relaxed text-slate-600">
              Transfer ke rekening resmi Yayasan Adara Relief Internasional, lalu konfirmasi via
              WhatsApp untuk mendapatkan nomor bukti & mencantumkan penyaluran. Laporan penyaluran
              dengan alamat dan jumlah dipublikasi berkala.
            </p>
            <a href={`${SITE.phoneHref}?text=${encodeURIComponent('Halo Adara, saya sudah transfer. Mohon konfirmasi.')}`} target="_blank" rel="noopener" class="mt-7 btn-primary">
              <Icon name="whatsapp" class="h-4 w-4" />
              Konfirmasi Transfer
            </a>
          </div>

          <div class="grid gap-3">
            {REK_ONGKOS.map((r) => (
              <button
                type="button"
                data-copy={r.no}
                class="group flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 text-left transition hover:border-brand-400 hover:bg-brand-50"
              >
                <div>
                  <p class="text-xs font-bold tracking-wider text-slate-400 uppercase">{r.bank}</p>
                  <p class="mt-0.5 font-mono text-sm font-bold text-slate-800 sm:text-base">{r.no}</p>
                </div>
                <span class="chip bg-white text-slate-500 ring-1 ring-slate-200 transition group-hover:bg-brand-700 group-hover:text-white">
                  Salin
                </span>
              </button>
            ))}
            <p class="pt-1 text-center text-xs text-slate-400">a.n. {SITE.legalName}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Salin nomor rekening
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('[data-copy]');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const val = btn.dataset.copy ?? '';
        const label = btn.querySelector('.chip');
        try {
          await navigator.clipboard.writeText(val);
          if (label) {
            label.textContent = 'Tersalin!';
            setTimeout(() => (label.textContent = 'Salin'), 1800);
          }
        } catch {
          /* clipboard tidak tersedia */
        }
      });
    });
  </script>
</BaseLayout>