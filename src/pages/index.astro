---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import KartuProgram from '../components/KartuProgram.astro';
import KartuBerita from '../components/KartuBerita.astro';
import KartuKomunitas from '../components/KartuKomunitas.astro';
import CtaKomunitas from '../components/CtaKomunitas.astro';
import { SITE, STATS } from '../data/site';
import { PROGRAM_PENYALURAN, PROGRAM_EDUKASI, VISI, SDG_LIST } from '../data/program';
import { beritaTerbaru } from '../data/berita';
import { KOMUNITAS } from '../data/komunitas';

const berita = beritaTerbaru(3);
const komunitasPilihan = [
  'Komunitas Muslimah Magelang Peduli Palestina',
  'Komunitas Pecinta Al Aqsha',
  'Komunitas Keluarga Cinta Palestina',
  'MATA PENA',
  'Komunitas Muslimah Jepara Peduli Palestina',
  'Aliansi Solidaritas Al Aqsha',
]
  .map((n) => KOMUNITAS.find((k) => k.nama === n))
  .filter((k) => k !== undefined);

const sdgDipakai = [1, 2, 3, 4, 6, 8, 10, 17];
const gaWash = encodeURIComponent(
  'Halo Adara, saya ingin berdonasi. Mohon informasi lebih lanjut.'
);
---

<BaseLayout
  title="Adara Relief International - Pemberdayaan Perempuan & Bantuan untuk Palestina"
  description="Adara Relief International adalah lembaga kemanusiaan yang dibentuk dari inisiasi perempuan Indonesia untuk membantu anak dan perempuan Palestina. 6 program bantuan, 6 program edukasi, 19 komunitas di seluruh Indonesia."
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-slate-950 pt-32 pb-20 sm:pt-40 sm:pb-28 lg:pt-44">
    <!-- Background -->
    <div class="pointer-events-none absolute inset-0 grid-pattern opacity-70"></div>
    <div
      class="pointer-events-none absolute -top-32 -left-24 h-[28rem] w-[28rem] rounded-full bg-brand-600/25 blur-[100px]"
    >
    </div>
    <div
      class="pointer-events-none absolute top-1/3 -right-24 h-[24rem] w-[24rem] rounded-full bg-indigo-600/20 blur-[100px]"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-amber-500/10 blur-[100px]"
    >
    </div>

    <div class="container-page relative">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
        <!-- Copy -->
        <div class="lg:col-span-7">
          <span
            class="chip animate-fade-up bg-white/10 text-brand-200 ring-1 ring-white/20 backdrop-blur"
            style="animation-delay: 60ms"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"
              >
              </span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-400"></span>
            </span>
            Aksi nyata Nusantara untuk Palestina
          </span>

          <h1
            class="mt-6 animate-fade-up text-4xl leading-[1.08] font-extrabold text-white sm:text-5xl lg:text-6xl xl:text-[4.2rem]"
            style="animation-delay: 140ms"
          >
            Setiap rupiah Anda,<br />
            <span class="text-gradient-light">satu harapan</span><br />
            bagi anak-anak Palestina.
          </h1>

          <p
            class="mt-6 max-w-xl animate-fade-up text-base leading-relaxed text-slate-300 sm:text-lg"
            style="animation-delay: 220ms"
          >
            {SITE.legalName} berdiri sejak 2008 atas inisiasi perempuan Indonesia. Bersama
            komunitas, kami memastikan kebutuhan dasar anak-anak dan perempuan
            Palestina terpenuhi.
          </p>

          <!-- CTA -->
          <div
            class="mt-9 flex flex-wrap items-center gap-3 animate-fade-up"
            style="animation-delay: 300ms"
          >
            <a href={SITE.donateUrl} target="_blank" rel="noopener" class="btn-accent">
              <Icon name="heart" class="h-4 w-4" />
              Donasi Sekarang
            </a>
            <a href="/program" class="btn-ghost-light">
              Lihat Program
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>

          <!-- Trust badges -->
          <dl
            class="mt-12 grid max-w-lg grid-cols-2 gap-x-6 gap-y-6 animate-fade-up sm:grid-cols-4"
            style="animation-delay: 380ms"
          >
            {
              STATS.map((s) => (
                <div>
                  <dt class="sr-only">{s.label}</dt>
                  <dd
                    class="font-display text-2xl font-extrabold text-white sm:text-3xl"
                    data-count-to={s.value}
                  >
                    {s.value.toLocaleString('id-ID')}
                  </dd>
                  <p class="mt-1 text-xs leading-tight text-slate-400">
                    {s.prefix}
                    {s.suffix}
                    {s.label}
                  </p>
                </div>
              ))
            }
          </dl>
        </div>

        <!-- Visual -->
        <div class="animate-fade-up lg:col-span-5" style="animation-delay: 460ms">
          <div class="relative mx-auto max-w-sm lg:max-w-none">
            <!-- Blob -->
            <div
              class="absolute -inset-6 -z-10 rounded-[3rem] bg-gradient-to-br from-brand-600/30 via-teal-500/20 to-transparent blur-2xl"
            >
            </div>

            <div
              class="relative overflow-hidden rounded-[2rem] border border-white/15 bg-white/5 p-3 shadow-2xl shadow-black/40 backdrop-blur-xl"
            >
              <img
                src="/img/komunitas-hero.jpg"
                alt="Anggota komunitas Adara gathered dalam kegiatan"
                width="1024"
                height="576"
                class="aspect-[4/3] w-full rounded-[1.5rem] object-cover"
                loading="eager"
                fetchpriority="high"
              />

              <!-- Floating card: komunitas -->
              <div
                class="absolute -bottom-6 -left-4 flex items-center gap-3 rounded-2xl border border-white/15 bg-white/95 px-4 py-3 shadow-2xl backdrop-blur sm:-left-8"
              >
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-600 to-teal-500 text-white"
                >
                  <Icon name="users" class="h-5 w-5" />
                </div>
                <div>
                  <p class="font-display text-lg font-extrabold text-slate-900">
                    {KOMUNITAS.length}+
                  </p>
                  <p class="text-[0.65rem] font-semibold tracking-wide text-slate-500 uppercase">
                    Komunitas aktif
                  </p>
                </div>
              </div>

              <!-- Floating card: program -->
              <div
                class="absolute -top-5 -right-3 flex items-center gap-3 rounded-2xl border border-white/15 bg-white/95 px-4 py-3 shadow-2xl backdrop-blur sm:-right-6"
              >
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 text-white"
                >
                  <Icon name="heart" class="h-5 w-5" />
                </div>
                <div>
                  <p class="font-display text-lg font-extrabold text-slate-900">12</p>
                  <p class="text-[0.65rem] font-semibold tracking-wide text-slate-500 uppercase">
                    Program aktif
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE MITRA ============ -->
  <section class="border-y border-slate-200 bg-white py-5">
    <div class="container-page">
      <p class="text-center text-[0.65rem] font-bold tracking-widest text-slate-400 uppercase">
       Didampingi dan didukung oleh
      </p>
    </div>
    <div class="mt-4 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
      <div class="flex w-max animate-marquee items-center gap-12 pr-12">
        {
          [0, 1].map(() => (
            <div class="flex items-center gap-12">
              {[
                'Komunitas Muslimah Magelang',
                'Aliansi Solidaritas Al Aqsha',
                'MATA PENA',
                'Komunitas Pecinta Al Aqsha',
                'Love For Palestine',
                'MQISA',
                'SAPA Malang Raya',
                'KOMPAQ Bogor',
              ].map((nama) => (
                <span class="flex items-center gap-2.5 text-sm font-bold whitespace-nowrap text-slate-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-400" />
                  {nama}
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ MISI & VISI ============ -->
  <Section
    eyebrow="Tentang Kami"
    judul="Lembaga kemanusiaan yang lahir dari 间concern perempuan Indonesia"
    deskripsi="Adara bukan sekadar organisasi donor. Kami membangun ekosistem: educator, aktivis, community leader, dan terakhir baru donatur."
  >
    <div slot="aksi" class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/tentang" class="btn-ghost">
        Selengkapnya tentang Adara
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      <!-- Visi -->
      <div
        class="relative overflow-hidden rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-7 lg:col-span-1"
        data-reveal
      >
        <div
          class="absolute -top-6 -right-6 h-24 w-24 rounded-full bg-brand-200/40 blur-2xl"
        >
        </div>
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-700 text-white">
          <Icon name="sparkle" class="h-5 w-5" />
        </span>
        <h3 class="mt-5 text-lg font-extrabold">Visi</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{VISI}</p>
      </div>

      <!-- Misi -->
      <div
        class="rounded-2xl border border-slate-200 bg-white p-7 lg:col-span-2"
        data-reveal
        data-reveal-delay="90"
      >
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-900 text-white">
            <Icon name="heart" class="h-5 w-5" />
          </span>
          <h3 class="text-lg font-extrabold">Misi</h3>
        </div>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            [
              'Menjadi lembaga terdepan, unggul, dan tercepat dalam edukasi dan informasi Palestina.',
              'Memfasilitasi sumber daya untuk memperluas manfaat dalam perjuangan Palestina.',
              'Memperluas dan memperkuat jaringan kerja sama dalam dan luar negeri.',
              'Sistem manajemen kerja yang transparan, akuntabel, dan profesional.',
              'Organisasi yang tangguh dan modern dengan nilai yang kuat.',
            ].map((m, i) => (
              <li class="flex items-start gap-3" data-reveal data-reveal-delay={120 + i * 50}>
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-xs font-extrabold text-brand-700">
                  {i + 1}
                </span>
                <span class="text-sm leading-relaxed text-slate-600">{m}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- ============ PROGRAM PENYALURAN ============ -->
  <section class="relative overflow-hidden bg-slate-950 py-16 sm:py-20 lg:py-24">
    <div class="pointer-events-none absolute inset-0 grid-pattern opacity-50"></div>
    <div
      class="pointer-events-none absolute top-0 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-brand-600/15 blur-[100px]"
    >
    </div>

    <div class="container-page relative">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow bg-white/10 text-brand-200 ring-white/20">Programmable Aid</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold text-white sm:text-4xl">
          Enam program penyaluran
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate-300 sm:text-lg">
          Dari bantuan darurat hingga pemberdayaan perempuan — dirancang agar manfaat tidak berhenti
          di tangan.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          PROGRAM_PENYALURAN.map((p, i) => (
            <KartuProgram program={p} index={i} />
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <a
          href="/program"
          class="btn-ghost-light mx-auto"
        >
          Lihat semua program
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ PROGRAM EDUKASI ============ -->
  <Section
    eyebrow="Edukasi"
    judul="Edukasi yang berakar dari riset, tumbuh dari komunitas"
    deskripsi="Adara percaya: seseorang tidak akan bergerak jika tidak paham. Karena itu kami membangun ekosistem edukasi yang dimulai dari keluarga."
  >
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROGRAM_EDUKASI.map((p, i) => (
          <KartuProgram program={p} index={i} />
        ))
      }
    </div>
  </Section>

  <!-- ============ KOMUNITAS ============ -->
  <section class="bg-sand-100 py-16 sm:py-20 lg:py-24">
    <div class="container-page">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow">Jaringan Komunitas</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">
          19 komunitas, 9 provinsi, satu tujuan
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Komunitas Adara pertama diinisiasi pada 2017. Kini tumbuh menjadi penggerak edukasi
          kepalestinian yang tersebar dari Sabang ke Merauke.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          komunitasPilihan.map((k, i) => (
            <KartuKomunitas komunitas={k} index={i} />
          ))
        }
      </div>

      <div class="mt-10 text-center">
        <a href="/komunitas" class="btn-primary mx-auto">
          Lihat Semua Komunitas
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SDG ============ -->
  <Section
    eyebrow="Dampak"
    judul="Berkontribusi pada 8 SDGs"
    deskripsi="Setiap program Adara dipetakan ke tujuan pembangunan berkelanjutan PBB, agar dampaknya terukur dan akuntabel."
  >
    <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        sdgDipakai.map((no, i) => {
          const s = SDG_LIST.find((x) => x.no === no)!;
          return (
            <div
              class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition-all hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg"
              data-reveal
              data-reveal-delay={i * 50}
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-900 font-display text-sm font-extrabold text-white transition-colors group-hover:bg-brand-700">
                {no}
              </span>
              <div class="min-w-0">
                <h3 class="text-sm font-bold text-slate-900">{s.name}</h3>
                <p class="mt-0.5 text-xs leading-relaxed text-slate-500">{s.full}</p>
              </div>
            </div>
          );
        })
      }
    </div>
  </Section>

  <!-- ============ BERITA ============ -->
  <Section
    eyebrow="Kabar Terbaru"
    judul="Berita, laporan, dan cerita lapangan"
    deskripsi="Pembaruan berkala dari Adara dan komunitas mitranya di seluruh Indonesia."
  >
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {berita.map((b, i) => <KartuBerita berita={b} index={i} />)}
    </div>

    <div class="mt-10 text-center">
      <a href="/berita" class="btn-ghost mx-auto">
        Semua berita
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </Section>

  <!-- ============ DONASI CTA ============ -->
  <section class="py-8 sm:py-12">
    <div class="container-page">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-700 via-brand-800 to-brand-950 px-6 py-14 text-center shadow-2xl shadow-brand-900/30 sm:px-12"
        data-reveal
      >
        <div class="pointer-events-none absolute inset-0 grid-pattern opacity-40"></div>
        <div
          class="pointer-events-none absolute -top-20 -left-10 h-64 w-64 rounded-full bg-brand-400/20 blur-3xl"
        >
        </div>
        <div
          class="pointer-events-none absolute -right-10 -bottom-20 h-64 w-64 rounded-full bg-amber-400/15 blur-3xl"
        >
        </div>

        <div class="relative mx-auto max-w-2xl">
          <span class="chip bg-white/15 text-white ring-1 ring-white/25 backdrop-blur">
            <Icon name="shield" class="h-3.5 w-3.5" />
            Terdaftar resmi &amp; teraudit
          </span>
          <h2 class="mt-6 text-3xl leading-tight font-extrabold text-white sm:text-4xl">
            Donasi Anda sampai, <span class="text-amber-300">dan tercatat</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-brand-100">
            Tanpa biaya admin. Setiap donasi dicatat dan dipublikasikan lewat laporan penyaluran secara berkala.
          </p>

          <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
            <a href={SITE.donateUrl} target="_blank" rel="noopener" class="btn-accent">
              <Icon name="heart" class="h-4 w-4" />
              Donasi via PasarDonasi
            </a>
            <a href={`${SITE.phoneHref}?text=${gaWash}`} target="_blank" rel="noopener" class="btn-ghost-light">
              <Icon name="whatsapp" class="h-4 w-4" />
              Tanya via WhatsApp
            </a>
          </div>

          <p class="mt-6 text-xs text-brand-200/80">
            atau transfer ke rekening resmi &middot; konfirmasi ke{' '}
            <a href={SITE.phoneHref} target="_blank" rel="noopener" class="underline hover:text-white">
              {SITE.phone}
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ KOMUNITAS CTA ============ -->
  <CtaKomunitas />
</BaseLayout>
