---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, REK_ONGKOS } from '../data/site';
import { VISI, MISI, LEGALITAS, MAKNA, SDG_LIST } from '../data/program';
import { KOMUNITAS } from '../data/komunitas';

const tahun = new Date().getFullYear();
const umur = tahun - 2008;
const provinsiCount = new Set(KOMUNITAS.map((k) => k.provinsi)).size;
---

<BaseLayout
  title="Tentang Adara"
  description="Adara Relief International: visi, misi, legalitas, makna logo, dan kontribusi terhadap SDGs. Lembaga kemanusiaan perempuan Indonesia untuk Palestina sejak 2008."
  image="/img/og-default.jpg"
>
  <!-- ============ HERO HALAMAN ============ -->
  <section class="relative overflow-hidden bg-slate-950 pt-32 pb-16 sm:pt-40 sm:pb-20">
    <div class="pointer-events-none absolute inset-0 grid-pattern opacity-70"></div>
    <div class="pointer-events-none absolute -top-20 left-1/3 h-80 w-80 rounded-full bg-brand-600/25 blur-[100px]"></div>

    <div class="container-page relative">
      <div class="max-w-3xl">
        <nav class="animate-fade-up flex items-center gap-2 text-xs font-semibold text-slate-400">
          <a href="/" class="transition hover:text-brand-300">Beranda</a>
          <span aria-hidden="true">/</span>
          <span class="text-brand-300">Tentang</span>
        </nav>

        <h1 class="mt-6 animate-fade-up text-4xl leading-tight font-extrabold text-white sm:text-5xl" style="animation-delay: 80ms">
          Lembaga kemanusiaan berbasis <span class="text-gradient-light">pemberdayaan</span>
        </h1>
        <p class="mt-5 animate-fade-up max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg" style="animation-delay: 160ms">
          Focus membantu kelompok rentan, yaitu anak dan perempuan — melalui penyaluran bantuan dan
          edukasi kepalestinian yang kredibel.
        </p>

        <!-- Stat band -->
        <dl class="mt-10 flex animate-fade-up flex-wrap gap-x-10 gap-y-6" style="animation-delay: 240ms">
          {[
            { v: tahun, l: 'Tahun berjalan' },
            { v: umur, l: 'Tahun mengabdi' },
            { v: provinsiCount, l: 'Provinsi komunitas' },
          ].map((s) => (
            <div>
              <dd class="font-display text-3xl font-extrabold text-brand-300 sm:text-4xl">{s.v.toLocaleString('id-ID')}</dd>
              <dt class="mt-1 text-xs font-semibold tracking-wide text-slate-400 uppercase">{s.l}</dt>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ INTRO ============ -->
  <section class="py-16 sm:py-20">
    <div class="container-page grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <span class="eyebrow">Siapa Kami</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">
          Lahir dari tangan perempuan Indonesia
        </h2>
        <div class="mt-6 space-y-4 text-[1.05rem] leading-relaxed text-slate-600">
          <p>
            Adara Relief International merupakan lembaga kemanusiaan yang dibentuk dari inisiasi
            perempuan Indonesia dalam rangka membantu kelompok rentan, yaitu anak dan perempuan.
          </p>
          <p>
            Didirikan pada <strong class="text-slate-900">14 Februari 2008</strong> atas inisiasi
            Alm. Yoyoh Yusroh, S.Pd.I., dan Dra. Siti Zainab, M.A. Sejak itu, Adara tumbuh menjadi
            lembaga yang kredibel, teraudit, dan berizin resmi.
          </p>
          <p>
            Dari Jakarta, jaringan kami meluas ke {provinsiCount} provinsi melalui {KOMUNITAS.length} komunitas
            dan berbagai akademi edukasi. Kami percaya: <em>keberpihakan tanpa pemahaman tidak akan
            bertahan lama.</em>
          </p>
        </div>
      </div>

      <!-- Makna -->
      <div class="lg:col-span-5">
        <div class="grid gap-5" data-reveal data-reveal-delay="120">
          <div class="card p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-700 text-white">
              <Icon name="globe" class="h-5 w-5" />
            </span>
            <h3 class="mt-4 text-lg font-extrabold">Makna Nama</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{MAKNA.sansekerta}</p>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{MAKNA.arab}</p>
          </div>

          <div class="card p-6">
            <div class="flex items-center gap-4">
              <img
                src="/img/logo.png"
                alt="Logo Adara: simbol hati yang mendekap anak"
                width="96"
                height="96"
                class="h-20 w-20 rounded-2xl bg-brand-50 object-contain p-2"
                loading="lazy"
              />
              <div>
                <h3 class="text-lg font-extrabold">Makna Logo</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{MAKNA.logo}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VISI MISI ============ -->
  <section class="bg-sand-100 py-16 sm:py-20">
    <div class="container-page">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow">Arah &amp; kompas</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">Visi &amp; Misi</h2>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-12">
        <div class="rounded-2xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-7 lg:col-span-4" data-reveal>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-700 text-white">
            <Icon name="sparkle" class="h-5 w-5" />
          </span>
          <h3 class="mt-4 text-lg font-extrabold">Visi</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{VISI}</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-7 lg:col-span-8" data-reveal data-reveal-delay="90">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-900 text-white">
            <Icon name="heart" class="h-5 w-5" />
          </span>
          <h3 class="mt-4 text-lg font-extrabold">Misi</h3>
          <ol class="mt-5 space-y-3.5">
            {MISI.map((m, i) => (
              <li class="flex items-start gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-xs font-extrabold text-brand-700">
                  {i + 1}
                </span>
                <span class="text-sm leading-relaxed text-slate-600 sm:text-base">{m}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LEGALITAS ============ -->
  <section id="legalitas" class="scroll-mt-24 py-16 sm:py-20">
    <div class="container-page">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow">Kredibilitas &amp; Kepercayaan</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">Legalitas &amp; Audit</h2>
        <p class="mt-4 text-slate-600">Terdaftar resmi, berizin, dan diaudit oleh kantor akuntan publik secara berkala.</p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        <div class="card p-6" data-reveal>
          <h3 class="flex items-center gap-2.5 text-base font-extrabold">
            <Icon name="book" class="h-5 w-5 text-brand-600" /> Akta Notaris
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-600">
            {LEGALITAS.notaris.map((l) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />{l}</li>)}
          </ul>
        </div>

        <div class="card p-6" data-reveal data-reveal-delay="70">
          <h3 class="flex items-center gap-2.5 text-base font-extrabold">
            <Icon name="shield" class="h-5 w-5 text-brand-600" /> Kemenkumham
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-600">
            {LEGALITAS.kemkumham.map((l) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />{l}</li>)}
          </ul>
        </div>

        <div class="card p-6" data-reveal data-reveal-delay="140">
          <h3 class="flex items-center gap-2.5 text-base font-extrabold">
            <Icon name="check" class="h-5 w-5 text-brand-600" /> Izin Pengumpulan
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-600">
            {LEGALITAS.izin.map((l) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />{l}</li>)}
          </ul>
        </div>

        <div class="card p-6" data-reveal data-reveal-delay="210">
          <h3 class="flex items-center gap-2.5 text-base font-extrabold">
            <Icon name="download" class="h-5 w-5 text-brand-600" /> Opini Audit Tahunan
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-600">
            {LEGALITAS.audit.map((l) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />{l}</li>)}
          </ul>
          <p class="mt-3 text-xs text-slate-400">Kantor Akuntan Publik Ahmad Raharjo Utomo</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SDG ============ -->
  <section class="bg-slate-950 py-16 sm:py-20">
    <div class="container-page">
      <div data-reveal class="max-w-3xl">
        <span class="eyebrow bg-white/10 text-brand-200 ring-white/20">Kontribusi Global</span>
        <h2 class="mt-4 text-3xl leading-tight text-white sm:text-4xl">Mendukung Agenda SDGs</h2>
        <p class="mt-4 text-slate-300">Program-program Adara berkontribusi pada tujuan pembangunan berkelanjutan PBB.</p>
      </div>

      <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {SDG_LIST.map((s, i) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur" data-reveal data-reveal-delay={i * 40}>
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/10 font-display text-sm font-extrabold text-brand-300">{s.no}</span>
              <div class="min-w-0">
                <h3 class="text-sm font-bold text-white">{s.name}</h3>
                <p class="mt-0.5 text-xs text-slate-400">{s.full}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ LOKASI ============ -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div data-reveal>
          <span class="eyebrow">Kantor Pusat</span>
          <h2 class="mt-4 text-3xl leading-tight font-extrabold sm:text-4xl">Kunjungi Kami</h2>
          <address class="mt-5 space-y-3 text-base leading-relaxed text-slate-600 not-italic">
            <p class="flex items-start gap-3">
              <Icon name="map-pin" class="mt-1 h-5 w-5 shrink-0 text-brand-600" />
              {SITE.address}
            </p>
            <p class="flex items-center gap-3">
              <Icon name="phone" class="h-5 w-5 shrink-0 text-brand-600" />
              {SITE.phone}
            </p>
            <p class="flex items-center gap-3">
              <Icon name="mail" class="h-5 w-5 shrink-0 text-brand-600" />
              {SITE.email}
            </p>
          </address>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={SITE.mapUrl} target="_blank" rel="noopener" class="btn-primary">
              <Icon name="map-pin" class="h-4 w-4" />
              Buka di Google Maps
            </a>
            <a href={SITE.phoneHref} target="_blank" rel="noopener" class="btn-ghost">
              <Icon name="whatsapp" class="h-4 w-4" />
              WhatsApp Kami
            </a>
          </div>
        </div>

        <div data-reveal data-reveal-delay="120">
          <div class="overflow-hidden rounded-3xl border border-slate-200 shadow-lg">
            <iframe
              src="https://www.google.com/maps?q=Jl.+Moh.+Kahfi+1,+Cipedak,+Jagakarsa,+Jakarta+Selatan&output=embed"
              width="100%"
              height="360"
              style="border: 0"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Lokasi kantor Adara Relief International"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>