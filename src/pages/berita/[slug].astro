---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import KartuBerita from '../../components/KartuBerita.astro';
import { BERITA, beritaTerbaru } from '../../data/berita';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return BERITA.map((berita) => ({
    params: { slug: berita.slug },
    props: { berita },
  }));
}

interface Props {
  berita: (typeof BERITA)[number];
}

const { berita } = Astro.props;
const kategoriWarna: Record<string, string> = {
  Penyaluran: 'bg-amber-100 text-amber-800',
  Edukasi: 'bg-indigo-100 text-indigo-800',
  Komunitas: 'bg-emerald-100 text-emerald-800',
  'Siaran Pers': 'bg-sky-100 text-sky-800',
  Laporan: 'bg-violet-100 text-violet-800',
};
const terkait = beritaTerbaru(3).filter((b) => b.slug !== berita.slug);
const shareURL = `${SITE.url}/berita/${berita.slug}`;
const shareText = encodeURIComponent(`Baca: ${berita.judul}`);

// Ringkasan "bodi" artikel yang di-generate dari data
const paragraf = [
  berita.ringkas,
  'Kabar ini kami sampaikan sebagai bagian dari komitmen Adara untuk menghadirkan informasi yang aktual, faktual, dan akuntabel kepada sahabat Adara. Seluruh program berjalan di bawah koordinasi tim lapangan serta kerja sama dengan mitra lokal di Palestina dan Indonesia.',
  'Untuk mendukung keberlanjutan program ini, sahabat dapat berdonasi melalui rekening resmi yang tersedia di halaman Program. Setiap donasi dicatat, dilaporkan, dan dipublikasikan secara berkala dalam bentuk laporan penyaluran.',
];
---

<BaseLayout
  title={berita.judul}
  description={berita.ringkas}
  image={berita.gambar}
  type="article"
  publishedTime={berita.tanggalISO}
>
  <!-- ============ HERO ARTIKEL ============ -->
  <section class="relative overflow-hidden bg-slate-950 pt-32 pb-14 sm:pt-40 sm:pb-16">
    <div class="pointer-events-none absolute inset-0 grid-pattern opacity-60"></div>
    <div class="pointer-events-none absolute -top-16 right-1/3 h-64 w-64 rounded-full bg-brand-600/20 blur-[100px]"></div>

    <div class="container-page relative">
      <nav class="animate-fade-up flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="transition hover:text-brand-300">Beranda</a>
        <span aria-hidden="true">/</span>
        <a href="/berita" class="transition hover:text-brand-300">Berita</a>
        <span aria-hidden="true">/</span>
        <span class="truncate text-brand-300">{berita.kategori}</span>
      </nav>

      <div class="mt-7 flex animate-fade-up flex-wrap items-center gap-3" style="animation-delay: 60ms">
        <span class:list={['chip', kategoriWarna[berita.kategori]]}>{berita.kategori}</span>
        <time datetime={berita.tanggalISO} class="flex items-center gap-1.5 text-sm text-slate-400">
          <Icon name="calendar" class="h-4 w-4" />
          {berita.tanggal}
        </time>
        <span class="flex items-center gap-1.5 text-sm text-slate-400">
          <Icon name="clock" class="h-4 w-4" />
          {berita.baca} menit baca
        </span>
      </div>

      <h1 class="mt-5 max-w-4xl animate-fade-up text-3xl leading-tight font-extrabold text-white sm:text-4xl lg:text-5xl" style="animation-delay: 120ms">
        {berita.judul}
      </h1>
    </div>
  </section>

  <!-- ============ GAMBAR & ARTIKEL ============ -->
  <article class="bg-sand-50 py-12 sm:py-16">
    <div class="container-page">
      <figure class="overflow-hidden rounded-3xl border border-slate-200 shadow-xl" data-reveal>
        <img
          src={berita.gambar}
          alt={berita.judul}
          width="1024"
          height="576"
          loading="eager"
          class="aspect-[16/9] w-full object-cover"
        />
      </figure>

      <!-- Share bar -->
      <div class="no-print mt-6 flex flex-wrap items-center gap-3" data-reveal>
        <span class="text-xs font-bold tracking-widest text-slate-400 uppercase">Bagikan:</span>
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareURL)}`}
          target="_blank"
          rel="noopener"
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-200 text-slate-600 transition hover:bg-slate-800 hover:text-white"
          aria-label="Bagikan di Facebook"
        >
          <Icon name="facebook" class="h-4 w-4" />
        </a>
        <a
          href={`https://twitter.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(shareURL)}`}
          target="_blank"
          rel="noopener"
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-200 text-slate-600 transition hover:bg-slate-900 hover:text-white"
          aria-label="Bagikan di X"
        >
          <Icon name="x" class="h-4 w-4" />
        </a>
        <a
          href={`https://api.whatsapp.com/send?text=${shareText}%0A${encodeURIComponent(shareURL)}`}
          target="_blank"
          rel="noopener"
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-200 text-slate-600 transition hover:bg-emerald-600 hover:text-white"
          aria-label="Bagikan di WhatsApp"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
        </a>
        <a
          href={`https://t.me/share/url?url=${encodeURIComponent(shareURL)}&text=${shareText}`}
          target="_blank"
          rel="noopener"
          class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-200 text-slate-600 transition hover:bg-sky-600 hover:text-white"
          aria-label="Bagikan di Telegram"
        >
          <Icon name="telegram" class="h-4 w-4" />
        </a>
        <span class="ml-auto hidden text-xs text-slate-400 sm:block">
          {berita.kategori} &middot; Adara Relief International
        </span>
      </div>

      <!-- Badan artikel -->
      <div class="prose-adara mx-auto mt-10 max-w-3xl" data-reveal data-reveal-delay="80">
        <p class="text-lg font-semibold text-slate-900 first-letter:float-left first-letter:mr-3 first-letter:font-display first-letter:text-6xl first-letter:leading-[0.85] first-letter:font-extrabold first-letter:text-brand-700">
          {paragraf[0]}
        </p>
        {paragraf.slice(1).map((p) => <p>{p}</p>)}
      </div>
    </div>
  </article>

  <!-- ============ BERITA TERKAIT ============ -->
  <section class="bg-sand-100 py-14 sm:py-18">
    <div class="container-page">
      <div data-reveal class="flex items-end justify-between gap-4">
        <div>
          <span class="eyebrow">Lanjut Membaca</span>
          <h2 class="mt-3 text-2xl font-extrabold sm:text-3xl">Berita terkait</h2>
        </div>
        <a href="/berita" class="btn-ghost shrink-0">
          Semua berita
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {terkait.map((b, i) => <KartuBerita berita={b} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ============ CTA DONASI ============ -->
  <section class="bg-slate-950 py-16">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <h2 class="text-2xl font-extrabold text-white sm:text-3xl">
          Terinspirasi membaca cerita ini?
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-400 sm:text-base">
          Jadilah bagian dari perubahan. Donasi Anda menjadi makanan, obat, air bersih, dan mimpi terwujud untuk anak-anak Palestina.
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <a href={SITE.donateUrl} target="_blank" rel="noopener" class="btn-accent">
            <Icon name="heart" class="h-4 w-4" />
            Donasi Sekarang
          </a>
          <a href="/faq" class="btn-ghost-light">Tanya jawab</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>