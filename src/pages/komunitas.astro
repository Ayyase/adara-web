---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import KartuKomunitas from '../components/KartuKomunitas.astro';
import CtaKomunitas from '../components/CtaKomunitas.astro';
import { SITE } from '../data/site';
import { KOMUNITAS, groupByWilayah } from '../data/komunitas';

const kelompok = groupByWilayah();
---

<BaseLayout
  title="Komunitas Adara"
  description="Daftar lengkap 19 komunitas Adara di 9 provinsi Indonesia yang bergerak dalam edukasi kepalestinian, donasi, dan pemberdayaan perempuan."
  image="/img/komunitas-hero.jpg"
>
  <!-- ============ HERO HALAMAN ============ -->
  <section class="relative overflow-hidden bg-slate-950 pt-32 pb-16 sm:pt-40 sm:pb-20">
    <div class="pointer-events-none absolute inset-0 grid-pattern opacity-70"></div>
    <div
      class="pointer-events-none absolute -top-24 left-1/4 h-80 w-80 rounded-full bg-brand-600/25 blur-[100px]"
    >
    </div>
    <div
      class="pointer-events-none absolute right-10 -bottom-20 h-72 w-72 rounded-full bg-teal-500/15 blur-[100px]"
    >
    </div>

    <div class="container-page relative">
      <div class="max-w-3xl">
        <nav class="animate-fade-up flex items-center gap-2 text-xs font-semibold text-slate-400">
          <a href="/" class="transition hover:text-brand-300">Beranda</a>
          <span aria-hidden="true">/</span>
          <span class="text-brand-300">Komunitas</span>
        </nav>

        <h1 class="mt-6 animate-fade-up text-4xl leading-tight font-extrabold text-white sm:text-5xl" style="animation-delay: 80ms">
          Penggerak edukasi yang <span class="text-gradient-light">tumbuh di mana-mana</span>
        </h1>
        <p class="mt-5 animate-fade-up max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg" style="animation-delay: 160ms">
          Pertama kali diinisiasi pada 2017, komunitas Adara kini menjadi jaringan penggerak
          kepalestinian terbesar di Indonesia — mandiri, lokal, dan berkelanjutan.
        </p>

        <!-- Statistik -->
        <dl class="mt-10 grid animate-fade-up grid-cols-3 gap-4 max-w-lg sm:gap-6" style="animation-delay: 240ms">
          {[
            { v: KOMUNITAS.length, l: 'Komunitas aktif' },
            { v: [...new Set(KOMUNITAS.map(k => k.provinsi))].length, l: 'Provinsi terwakili' },
            { v: [...new Set(KOMUNITAS.map(k => k.wilayah))].length, l: 'Wilayah' },
          ].map((s) => (
            <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 backdrop-blur">
              <dd class="font-display text-2xl font-extrabold text-brand-300 sm:text-3xl" data-count-to={s.v}>
                {s.v}
              </dd>
              <dt class="mt-1 text-[0.65rem] font-semibold tracking-wide text-slate-400 uppercase">{s.l}</dt>
            </div>
          ))}
        </dl>
      </div>

      <!-- Gambar hero -->
      <div class="mt-12 animate-fade-up" style="animation-delay: 320ms">
        <div class="relative overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
          <img
            src="/img/komunitas-hero.jpg"
            alt="Berkumpulnya pengurus komunitas Adara dalam sebuah kegiatan"
            width="1024"
            height="576"
            class="aspect-[21/9] w-full object-cover sm:aspect-[3/1]"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/10 to-transparent"></div>
          <p class="absolute inset-x-0 bottom-0 flex items-center gap-2 p-5 text-xs font-semibold text-brand-100/90 sm:p-8">
            <Icon name="users" class="h-4 w-4" />
            Pengurus Komunitas Adara
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DAERAH CEPAT ============ -->
  <div class="no-print border-b border-slate-200 bg-white py-4">
    <div class="container-page flex flex-wrap items-center gap-2">
      <span class="text-xs font-bold tracking-wider text-slate-400 uppercase">Lompat ke:</span>
      {kelompok.map((g) => (
        <a
          href={`#${g.wilayah.toLowerCase().replace(/[^a-z& ]/g, '').replace(/&/g, 'and').replace(/\s+/g, '-')}`}
          class="chip bg-slate-50 text-slate-600 transition hover:bg-brand-50 hover:text-brand-700"
        >
          {g.wilayah}
        </a>
      ))}
    </div>
  </div>

  <!-- ============ PETA / DAFTAR KOMUNITAS ============ -->
  <section class="bg-sand-100 py-16 sm:py-20">
    <div class="container-page">
      {kelompok.map((g, gi) => {
        const anchor = g.wilayah.toLowerCase().replace(/[^a-z& ]/g, '').replace(/&/g, 'and').replace(/\s+/g, '-');
        return (
          <div id={anchor} key={anchor} class="scroll-mt-28">
            <div class="flex items-center gap-3" data-reveal>
              <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-700 text-white">
                <Icon name="map-pin" class="h-4 w-4" />
              </span>
              <h2 class="text-2xl font-extrabold sm:text-3xl">{g.wilayah}</h2>
              <span class="chip bg-brand-100 text-brand-800">{g.items.length} komunitas</span>
            </div>

            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {g.items.map((k, ki) => (
                <KartuKomunitas komunitas={k} index={gi * 10 + ki} />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <CtaKomunitas />
</BaseLayout>