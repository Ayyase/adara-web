---
import Icon from './Icon.astro';
import type { Komunitas } from '../data/komunitas';
import { SITE } from '../data/site';

interface Props {
  komunitas: Komunitas;
  index?: number;
}

const { komunitas, index = 0 } = Astro.props;

// Inisial untuk avatar
const inisial = komunitas.singkat
  .replace(/[^A-Za-z0-9]/g, '')
  .slice(0, 3)
  .toUpperCase();

const warnaAvatar = [
  'from-brand-500 to-teal-500',
  'from-indigo-500 to-violet-500',
  'from-amber-500 to-orange-500',
  'from-rose-500 to-pink-500',
  'from-sky-500 to-cyan-500',
  'from-emerald-500 to-lime-500',
];
const gradien = warnaAvatar[index % warnaAvatar.length];

const pesanWA = encodeURIComponent(
  `Assalamu'alaikum, saya ${komunitas.nama} (${komunitas.singkat}) dari ${komunitas.kota}. Kami ingin terhubung dengan Adara Relief International.`
);
---

<article
  class="group relative flex h-full flex-col rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-300 hover:shadow-xl hover:shadow-slate-200/60"
  data-reveal
  data-reveal-delay={Math.min(index * 45, 360)}
>
  <!-- Avatar -->
  <div class="flex items-start gap-3.5">
    <div
      class:list={[
        'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-sm font-extrabold text-white shadow-md',
        gradien,
      ]}
      aria-hidden="true"
    >
      {inisial}
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="text-sm leading-snug font-extrabold text-slate-900 sm:text-[0.95rem]">
        {komunitas.nama}
      </h3>
      <p class="mt-1 flex items-center gap-1 text-xs font-semibold text-brand-700">
        <Icon name="map-pin" class="h-3.5 w-3.5 shrink-0" />
        <span class="truncate">{komunitas.kota}, {komunitas.provinsi}</span>
      </p>
    </div>
  </div>

  <!-- Fokus -->
  <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">
    <span class="font-semibold text-slate-500">Fokus:</span>
    {komunitas.fokus}
  </p>

  <!-- Aksi -->
  <div
    class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100 focus-within:opacity-100"
  >
    <span class="chip bg-slate-50 text-slate-500">{komunitas.wilayah}</span>
    <a
      href={`${SITE.phoneHref}?text=${pesanWA}`}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1 text-xs font-bold text-brand-700 transition hover:gap-2"
      aria-label={`Hubungi ${komunitas.nama} via WhatsApp`}
    >
      Hubungi
      <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
    </a>
  </div>
</article>
