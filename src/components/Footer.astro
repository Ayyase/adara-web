---
import Icon from './Icon.astro';
import { SITE, SOCIALS, NAV, REK_ONGKOS } from '../data/site';
import { KOMUNITAS } from '../data/komunitas';

const tahun = new Date().getFullYear();
const provinsiUnik = [...new Set(KOMUNITAS.map((k) => k.provinsi))];
---

<footer class="no-print mt-24 bg-slate-950 text-slate-300">
  <!-- CTA strip -->
  <div class="border-b border-white/10 bg-brand-950/50">
    <div class="container-page flex flex-col items-center gap-6 py-10 text-center sm:py-12">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-extrabold text-white sm:text-3xl">
          Mari bersuara dan <span class="text-brand-300">berpihak</span> untuk Palestina
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-400 sm:text-base">
          Setiap rupiah yang Anda salurkan menjadi makanan, obat, air bersih, dan pendidikan bagi
          anak-anak Palestina. Laporan sehari-hari kami publikkan secara terbuka.
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={SITE.donateUrl} target="_blank" rel="noopener" class="btn-accent">
          <Icon name="heart" class="h-4 w-4" />
          Donasi Sekarang
        </a>
        <a href="/program" class="btn-ghost-light">
          Lihat Program
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>

  <!-- Main footer -->
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
    <!-- Brand -->
    <div class="lg:col-span-4">
      <div class="flex items-center gap-3">
        <img
          src="/img/logo.png"
          alt="Logo Adara Relief International"
          width="48"
          height="48"
          class="h-12 w-12 rounded-xl bg-white/10 object-contain p-1"
          loading="lazy"
        />
        <div class="flex flex-col leading-none">
          <span class="font-display text-lg font-extrabold text-white">
            Adara<span class="text-brand-400"> Relief</span>
          </span>
          <span class="mt-1 text-[0.6rem] font-semibold tracking-widest text-slate-500 uppercase">
            International
          </span>
        </div>
      </div>
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-slate-400">
        {SITE.tagline}. Didirikan pada {SITE.foundedDate} atas inisiasi perempuan Indonesia untuk
        membantu kelompok rentan, yaitu anak dan perempuan.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {
          SOCIALS.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              title={s.label}
              class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/5 text-slate-400 transition hover:-translate-y-0.5 hover:bg-brand-600 hover:text-white"
            >
              <Icon name={s.icon as any} class="h-4 w-4" />
            </a>
          ))
        }
      </div>
    </div>

    <!-- Nav -->
    <nav class="lg:col-span-2" aria-label="Navigasi footer">
      <h3 class="text-sm font-bold tracking-wider text-white uppercase">Navigasi</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="link-underline transition hover:text-brand-300">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={SITE.donateUrl}
            target="_blank"
            rel="noopener"
            class="link-underline transition hover:text-brand-300"
          >
            Donasi
          </a>
        </li>
      </ul>
    </nav>

    <!-- Program -->
    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold tracking-wider text-white uppercase">Program Unggulan</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a href="/program#darurat" class="link-underline transition hover:text-brand-300">
            Program Darurat
          </a>
        </li>
        <li>
          <a href="/program#perempuan" class="link-underline transition hover:text-brand-300">
            Pemberdayaan Perempuan
          </a>
        </li>
        <li>
          <a href="/program#dyp" class="link-underline transition hover:text-brand-300">
            Dekap Yatim Palestina
          </a>
        </li>
        <li>
          <a href="/program#haq" class="link-underline transition hover:text-brand-300">
            Hidupkan Ahlul Qur’an
          </a>
        </li>
        <li>
          <a href="/program#air" class="link-underline transition hover:text-brand-300">
            Air Bersih
          </a>
        </li>
        <li>
          <a href="/program#satu-rumah" class="link-underline transition hover:text-brand-300">
            Satu Rumah Satu Aqsa
          </a>
        </li>
      </ul>
    </div>

    <!-- Rekening -->
    <div class="lg:col-span-3">
      <h3 class="text-sm font-bold tracking-wider text-white uppercase">Rekening Donasi</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          REK_ONGKOS.map((r) => (
            <li class="flex items-baseline justify-between gap-3 border-b border-white/5 pb-2">
              <span class="text-slate-400">{r.bank}</span>
              <span class="font-mono text-xs font-semibold text-brand-300">{r.no}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-slate-500">a.n. {SITE.legalName}</p>
    </div>

    <!-- Kontak -->
    <div class="lg:col-span-12">
      <div class="grid gap-4 rounded-2xl border border-white/10 bg-white/5 p-5 sm:grid-cols-3">
        <a
          href={SITE.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-3 text-sm"
        >
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" />
          <span class="text-slate-400 transition group-hover:text-white">{SITE.address}</span>
        </a>
        <a href={SITE.phoneHref} target="_blank" rel="noopener" class="group flex items-center gap-3 text-sm">
          <Icon name="whatsapp" class="h-4 w-4 shrink-0 text-brand-400" />
          <span class="text-slate-400 transition group-hover:text-white">{SITE.phone}</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="group flex items-center gap-3 text-sm">
          <Icon name="mail" class="h-4 w-4 shrink-0 text-brand-400" />
          <span class="text-slate-400 transition group-hover:text-white">{SITE.email}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div
      class="container-page flex flex-col items-center justify-between gap-4 py-6 text-center text-xs text-slate-500 sm:flex-row sm:text-left"
    >
      <p>
        &copy; {tahun}
        <a href="/" class="font-semibold text-slate-400 transition hover:text-brand-300">
          {SITE.legalName}
        </a>
        &middot; Terdaftar &amp; berizin resmi di Indonesia
      </p>
      <div class="flex items-center gap-4">
        <span class="hidden sm:inline">
          {KOMUNITAS.length} komunitas &middot; {provinsiUnik.length} provinsi
        </span>
        <a href="/faq" class="transition hover:text-brand-300">FAQ</a>
        <a href="/tentang#legalitas" class="transition hover:text-brand-300">Legalitas</a>
        <a href="#back-to-top" class="transition hover:text-brand-300">Ke atas ↑</a>
      </div>
    </div>
  </div>
</footer>
