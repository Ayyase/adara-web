---
import Icon from './Icon.astro';
import { SITE } from '../data/site';

interface Props {
  judul?: string;
  subjudul?: string;
}

const {
  judul = 'Mari Bergabung dengan Komunitas Adara',
  subjudul = 'Sudah 19 komunitas di 9 provinsi bergerak bersama. Daerah Anda belum punya? Ayo kita bentuk bersama.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-brand-950 py-16 sm:py-20">
  <!-- Dekorasi -->
  <div class="pointer-events-none absolute inset-0 grid-pattern opacity-60"></div>
  <div
    class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-teal-500/10 blur-3xl"
  >
  </div>

  <div class="container-page relative">
    <div
      class="mx-auto max-w-2xl text-center"
      data-reveal
    >
      <span class="chip bg-white/10 text-brand-200 ring-1 ring-white/20 backdrop-blur">
        <Icon name="users" class="h-3.5 w-3.5" />
        Jaringan Komunitas
      </span>
      <h2 class="mt-5 text-3xl leading-tight font-extrabold text-white sm:text-4xl">
        {judul}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-300">{subjudul}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${SITE.phoneHref}?text=${encodeURIComponent('Halo Adara, saya ingin mengajukan komunitas Palestina di daerah saya.')}`}
          target="_blank"
          rel="noopener"
          class="btn-accent"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          Ajukan Komunitas
        </a>
        <a href="/komunitas" class="btn-ghost-light">
          Lihat Daftar Komunitas
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <!-- Langkah -->
      <ol class="mt-12 grid gap-6 text-left sm:grid-cols-3">
        {
          [
            { n: '01', t: 'Konsultasi', d: 'Hubungi tim Adara dan ceritakan kondisi daerah Anda.' },
            { n: '02', t: 'Pendampingan', d: 'Adara menyiapkan kurikulum, materi, dan mentor.' },
            { n: '03', t: 'Aktivasi', d: 'Komunitas siap melakukan kegiatan dan aksi bersama.' },
          ].map((s) => (
            <li class="relative rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
              <span class="font-display text-2xl font-extrabold text-brand-400">{s.n}</span>
              <h3 class="mt-2 text-sm font-bold text-white">{s.t}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-400">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
